{
	"name": "obsidian-epub_rs-plugin",
	"version": "1.1.1",
	"description": "添加obsidian对epub的相关支持",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "npm run build:wasm && tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"dev:wasm": "node build-wasm.mjs --watch",
		"build:wasm": "node build-wasm.mjs --release",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [],
	"author": "sensfloron@outlook.com",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^16.11.6",
		"@typescript-eslint/eslint-plugin": "5.29.0",
		"@typescript-eslint/parser": "5.29.0",
		"builtin-modules": "3.3.0",
		"esbuild": "0.17.3",
		"obsidian": "latest",
		"tslib": "2.4.0",
		"typescript": "4.7.4"
	}
}
